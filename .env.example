# --- API (Fly.io) -----------------------------------------------------------
# Where downloads and generated clips are written. Point this at a mounted
# volume, e.g. /data, so clips survive restarts.
SKIMREEL_DOWNLOAD_DIR=

# Comma-separated exact origins allowed to call the API from a browser. The SPA
# is served by Vercel, so set this to your real domain. Do not use "*": the API
# accepts uploads and bills your bandwidth.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8443

# Auto-cleanup. Starting a new analysis already releases the previous job's
# downloaded videos. This is the backstop for artifacts orphaned by a restart,
# since jobs are tracked in memory and the files outlive the process: at boot,
# anything in SKIMREEL_DOWNLOAD_DIR older than this many hours is deleted. 0
# disables the sweep. Keep it above your longest expected analysis.
SKIMREEL_ARTIFACT_TTL_HOURS=24

# YouTube blocks anonymous datacenter IPs with "Sign in to confirm you're not a
# bot". Supplying cookies is the reliable fix. Both forms below are live account
# sessions: never commit either, and rotate the account if they leak.
#
# Alternative: read cookies straight from a locally installed browser.
# Format: <browser>[:<profile>][:<container>], e.g. firefox or chrome:Default.
# Only useful when SkimReel runs on the same machine as that browser.
YTDLP_COOKIES_FROM_BROWSER=

# The cookie file itself, in Netscape format. Used by local runs when the file is
# already on disk. Ignored if the path does not exist.
#   yt-dlp --cookies-from-browser chrome --cookies cookies.txt "<some url>"
YTDLP_COOKIES_FILE=

# Inline cookie text, same Netscape format. Preferred on container platforms,
# where a secret is passed as an env var rather than a file on a volume:
#   fly secrets set YTDLP_COOKIES="$(cat cookies.txt)"
# Takes effect only when YTDLP_COOKIES_FILE finds no readable file.
# Either way, treat it as a live account session: never commit it.
YTDLP_COOKIES=

# Optional TLS impersonation, e.g. chrome. Requires: pip install curl_cffi
YTDLP_IMPERSONATE=

# NOTE: VITE_API_BASE belongs to the frontend and is read from frontend/.env,
# not from this file. The committed frontend/public/config.js is the usual path.
# See frontend/.env.example.